{
    "name": "relaybase/relaybase-php",
    "description": "Official PHP SDK for the Relaybase email validation API",
    "type": "library",
    "license": "MIT",
    "keywords": ["relaybase", "email", "validation", "sdk"],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Relaybase\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Relaybase\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable"
}
